# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# ── Gemini AI (REQUIRED for AI features) ─────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Free tier available. Supports: gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (choose one) ─────────────────────────────────────────────────────
# Option A: Supabase (recommended for production)
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_ANON_KEY=your_anon_key_here  # Only if not using service role key

# Option B: Local SQLite (default fallback — works without any config)
# Set USE_SQLITE=true to force SQLite even if Supabase is configured
# USE_SQLITE=true
# DATABASE_PATH=./database.sqlite

# ── Job APIs (optional — sample jobs shown if not configured) ─────────────────
# Adzuna: https://developer.adzuna.com (free tier: 500 req/month)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# RapidAPI JSearch (LinkedIn + Indeed + Glassdoor):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key

# ── GitHub API (optional — increases rate limit for GitHub Analyzer) ──────────
# Get from: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_personal_access_token
